---
import BaseLayout from '../layouts/BaseLayout.astro';
import ParticleHero from './ParticleHero.astro';
import DotCutHero from './DotCutHero.astro';
import SectionHeading from './SectionHeading.astro';
import Icon from './Icon.astro';
import PhotoGalaxy from './PhotoGalaxy.astro';
import NowListeningCard from './now-listening/NowListeningCard';
import JournalStream from './JournalStream.astro';
import { getLatestPublicSong, getMergedFeed, requireDb } from '../lib/data';
import { photos } from '../lib/photos.gen';
import type { Locale } from '../i18n';
import { ui } from '../i18n';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = ui[locale];
const prefix = locale === 'zh' ? '' : '/en';

// 照片墙（构建时清单：public/photos）
const galaxyImages = photos.map((p) => ({
  src: `/photos/${p.file}`,
  poster: /\.gif$/i.test(p.file)
    ? `/photos/${p.file.replace(/\.gif$/i, '-poster.jpg')}`
    : undefined,
  caption: locale === 'zh' ? p.zh : p.en,
}));

// 最近在听（Holo 卡）+ 统一内容流（瀑布流，CSS columns 自上而下自左而右）
let latestSong: Awaited<ReturnType<typeof getLatestPublicSong>> | undefined;
let feed: Awaited<ReturnType<typeof getMergedFeed>> = [];
try {
  const db = await requireDb();
  latestSong = await getLatestPublicSong(db);
  feed = (await getMergedFeed(db, locale, { limit: 15 })).filter(
    (item) => !(latestSong && item.key === `diary-${latestSong.dbId}`),
  );
} catch {
  latestSong = undefined;
  feed = [];
}
const songDate = latestSong
  ? new Intl.DateTimeFormat(locale === 'zh' ? 'zh-CN' : 'en-US', {
      year: 'numeric',
      month: 'short',
      day: 'numeric',
    }).format(latestSong.createdAt)
  : '';
---

<BaseLayout
  locale={locale}
  title={`lordestar · ${t.site.tagline}`}
  description={t.site.description}
>
  <ParticleHero replayLabel={t.hero.replay} scrollLabel={t.hero.scroll} />

  <DotCutHero variant="bar" symbol="L" />

  <!-- 关于（下放到首页） -->
  <section class="section">
    <div class="container">
      <div class="home-about glass-strong" data-reveal>
        <div class="home-about-copy">
          <span class="eyebrow">{t.home.aboutEyebrow}</span>
          <h2 class="about-title">{t.home.aboutTitle}</h2>
          <p class="about-body">{t.home.aboutBody}</p>
        </div>
        <div class="home-facts">
          {
            ui[locale].about.facts.map((fact, index) => (
              <div class="fact-row" style={`--reveal-delay: ${index * 70}ms`}>
                <span class="fact-label">{fact.label}</span>
                <span class="fact-value">{fact.value}</span>
              </div>
            ))
          }
        </div>
      </div>
    </div>
  </section>

  <!-- 照片墙（从"关于"页移来） -->
  <section class="section galaxy-section">
    <div class="container">
      <div class="galaxy-frame glass" data-reveal>
        <PhotoGalaxy images={galaxyImages} locale={locale}>
          <div class="galaxy-copy">
            <span class="eyebrow">{ui[locale].about.galleryEyebrow}</span>
            <h2>{ui[locale].about.galleryTitle}</h2>
            <p>{ui[locale].about.galleryBody}</p>
          </div>
        </PhotoGalaxy>
      </div>
    </div>
  </section>

  <!-- 日记本（Holo 卡 = 最近在听，固定左上第一张） -->
  <section class="section">
    <div class="container">
      <SectionHeading eyebrow={t.journal.sectionEyebrow} title={t.journal.sectionTitle} />
      <p class="section-subtitle" data-reveal>{t.journal.sectionSubtitle}</p>
      {
        latestSong || feed.length > 0 ? (
          <JournalStream items={feed} locale={locale}>
            {latestSong && (
              <div slot="pinned">
                <NowListeningCard
                  client:load
                  label={t.home.nowListeningTitle}
                  diaryHref={`${prefix}/diary/`}
                  song={{
                    title: latestSong.title,
                    artist: latestSong.artist,
                    cover: latestSong.cover,
                    songUrl: latestSong.songUrl,
                    dateLabel: songDate,
                  }}
                />
              </div>
            )}
          </JournalStream>
        ) : (
          <p class="empty">{t.home.nowListeningEmpty}</p>
        )
      }
      <div class="view-all" data-reveal>
        <a class="btn" href={`${prefix}/journal/`}>
          {t.journal.viewAll} →
        </a>
      </div>
    </div>
  </section>

  <!-- 轨迹 + 常出没 -->
  <section class="section">
    <div class="container">
      <div class="home-meta-grid">
        <div class="timeline-block glass" data-reveal>
          <span class="eyebrow">{ui[locale].about.timelineTitle}</span>
          <div class="timeline">
            {
              ui[locale].about.timeline.map((item) => (
                <div class="timeline-item">
                  <span class="timeline-date">{item.date}</span>
                  <div class="timeline-content">
                    <h3>{item.title}</h3>
                    <p>{item.text}</p>
                  </div>
                </div>
              ))
            }
          </div>
        </div>
        <div class="tools-block glass" data-reveal>
          <span class="eyebrow">{ui[locale].about.toolsTitle}</span>
          <div class="tools-list">
            {ui[locale].about.tools.map((tool) => <span class="tag tool-tag">{tool}</span>)}
          </div>
        </div>
      </div>
    </div>
  </section>

  <section class="section contact-band">
    <div class="container">
      <div class="contact-panel glass-strong" data-reveal>
        <div>
          <span class="eyebrow">{t.home.contactEyebrow}</span>
          <h2>{t.home.contactTitle}</h2>
          <p>{t.home.contactBody}</p>
        </div>
        <div class="contact-actions">
          <a class="btn btn-solid" href="mailto:hello@lordestar.dev">
            <Icon name="mail" size={16} />
            {t.home.emailLabel}
          </a>
          <a class="btn" href="https://github.com/lordestar" target="_blank" rel="noreferrer">
            <Icon name="github" size={16} />
            GitHub
          </a>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  /* 照片墙（移植自原关于页） */
  .galaxy-section {
    padding-block: 0 96px;
  }

  .galaxy-frame {
    position: relative;
    height: 560px;
    overflow: hidden;
  }

  .galaxy-copy {
    max-width: 560px;
    padding: 32px;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 14px;
    text-align: center;
  }

  .galaxy-copy h2 {
    font-family: var(--font-display);
    font-size: clamp(2rem, 4vw, 3.2rem);
    font-weight: 680;
    letter-spacing: 0;
    line-height: 1.05;
  }

  .galaxy-copy p {
    color: var(--text-soft);
    font-size: 1.02rem;
  }

  .home-about {
    display: grid;
    grid-template-columns: 1.4fr 1fr;
    gap: 40px;
    padding: 40px;
  }

  .home-about-copy {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 18px;
  }

  .about-title {
    font-family: var(--font-display);
    font-size: clamp(1.7rem, 3vw, 2.6rem);
    font-weight: 680;
    letter-spacing: 0;
    line-height: 1.08;
  }

  .about-body {
    max-width: 520px;
    color: var(--text-soft);
    font-size: 1.02rem;
  }

  .home-facts {
    display: flex;
    flex-direction: column;
    justify-content: center;
    border-left: 1px solid var(--border);
    padding-left: 32px;
  }

  .fact-row {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 16px;
    padding-block: 13px;
    border-bottom: 1px solid var(--border-soft);
  }

  .fact-row:last-child {
    border-bottom: 0;
  }

  .fact-label {
    font-family: var(--font-mono);
    font-size: 0.72rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--muted);
  }

  .fact-value {
    color: var(--text);
    font-size: 0.96rem;
    text-align: right;
  }

  .view-all {
    margin-top: 28px;
    text-align: center;
  }

  .section-subtitle {
    color: var(--muted);
    font-size: 0.95rem;
    margin: -14px 0 26px;
  }

  /* 轨迹 + 常出没 */
  .home-meta-grid {
    display: grid;
    grid-template-columns: 1.3fr 1fr;
    gap: 20px;
    align-items: start;
  }

  .timeline-block,
  .tools-block {
    padding: 30px;
    display: flex;
    flex-direction: column;
    gap: 18px;
  }

  .timeline {
    display: flex;
    flex-direction: column;
    gap: 18px;
  }

  .timeline-item {
    display: grid;
    grid-template-columns: 96px 1fr;
    gap: 16px;
  }

  .timeline-date {
    font-family: var(--font-mono);
    font-size: 0.72rem;
    color: var(--muted);
    padding-top: 3px;
  }

  .timeline-content h3 {
    font-family: var(--font-display);
    font-size: 1.05rem;
    font-weight: 650;
    letter-spacing: 0;
  }

  .timeline-content p {
    color: var(--text-soft);
    font-size: 0.9rem;
    margin-top: 4px;
  }

  .tools-list {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
  }

  .tool-tag {
    font-size: 0.85rem;
    padding: 6px 14px;
  }

  .empty {
    color: var(--muted);
    text-align: center;
    padding: 40px 0;
  }

  .contact-band {
    padding-top: 0;
  }

  .contact-panel {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 32px;
    padding: 40px;
  }

  .contact-panel > div:first-child {
    display: flex;
    flex-direction: column;
    gap: 12px;
  }

  .contact-panel h2 {
    font-family: var(--font-display);
    font-size: clamp(1.6rem, 2.6vw, 2.3rem);
    font-weight: 680;
    letter-spacing: 0;
  }

  .contact-panel p {
    color: var(--text-soft);
  }

  .contact-actions {
    display: flex;
    gap: 12px;
    flex-shrink: 0;
  }

  @media (max-width: 860px) {
    .galaxy-frame {
      height: 420px;
    }

    .home-about {
      grid-template-columns: 1fr;
      padding: 28px;
    }

    .home-facts {
      border-left: 0;
      padding-left: 0;
      border-top: 1px solid var(--border);
      padding-top: 8px;
    }

    .home-meta-grid {
      grid-template-columns: 1fr;
    }

    .contact-panel {
      flex-direction: column;
      align-items: flex-start;
      padding: 28px;
    }
  }
</style>
