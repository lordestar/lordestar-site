---
import type { CollectionEntry } from 'astro:content';
import Icon from './Icon.astro';
import MusicVisualizer from './MusicVisualizer.astro';
import type { Locale } from '../i18n';
import { ui } from '../i18n';

interface Props {
  entry: CollectionEntry<'works'>;
  locale: Locale;
}

const { entry, locale } = Astro.props;
const t = ui[locale];
const { title, type, date, summary, tags, link, audio, cover } = entry.data;
const accent = type === 'music' ? '#f08a6f' : '#7fc8c0';
const dateLabel = new Intl.DateTimeFormat(locale === 'zh' ? 'zh-CN' : 'en-US', {
  year: 'numeric',
  month: 'short',
}).format(date);
---

<article class="work-card glass" data-reveal data-type={type}>
  <div class="work-media" style={`--accent: ${accent}`}>
    {
      cover ? (
        <img src={cover} alt={title} loading="lazy" />
      ) : audio ? (
        <MusicVisualizer audio={audio} accent={accent} title={title} />
      ) : (
        <div class="work-placeholder">
          <Icon name={type === 'music' ? 'music' : 'code'} size={40} />
          <span class="work-kind">{type}</span>
        </div>
      )
    }
    <span class="work-type-badge">{type}</span>
  </div>

  <div class="work-body">
    <div class="work-meta">
      <span>{dateLabel}</span>
      {tags.slice(0, 3).map((tag) => <span class="tag">{tag}</span>)}
    </div>
    <h3>{title}</h3>
    <p>{summary}</p>
    {
      link && (
        <a class="text-link" href={link} target="_blank" rel="noreferrer">
          {t.works.external}
          <Icon name="external-link" size={15} />
        </a>
      )
    }
  </div>
</article>

<style>
  .work-card {
    display: flex;
    flex-direction: column;
    overflow: hidden;
    min-width: 0;
  }

  .work-media {
    position: relative;
    aspect-ratio: 16 / 9;
    overflow: hidden;
    border-bottom: 1px solid var(--border-soft);
    background:
      linear-gradient(135deg, color-mix(in srgb, var(--accent) 16%, transparent), transparent 60%),
      rgba(255, 255, 255, 0.03);
  }

  .work-media img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .work-placeholder {
    position: absolute;
    inset: 0;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 10px;
    color: var(--accent);
  }

  .work-kind {
    font-family: var(--font-mono);
    font-size: 0.7rem;
    text-transform: uppercase;
    letter-spacing: 0.16em;
    color: var(--muted);
  }

  .work-type-badge {
    position: absolute;
    top: 12px;
    left: 12px;
    padding: 5px 10px;
    border-radius: 999px;
    background: rgba(13, 15, 14, 0.72);
    border: 1px solid var(--border);
    backdrop-filter: blur(10px);
    font-family: var(--font-mono);
    font-size: 0.66rem;
    text-transform: uppercase;
    letter-spacing: 0.12em;
    color: var(--text-soft);
  }

  .work-body {
    display: flex;
    flex-direction: column;
    gap: 10px;
    padding: 20px;
    flex: 1;
  }

  .work-meta {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 8px;
    font-family: var(--font-mono);
    font-size: 0.7rem;
    color: var(--muted);
  }

  .work-body h3 {
    font-family: var(--font-display);
    font-size: 1.22rem;
    font-weight: 650;
    letter-spacing: 0;
  }

  .work-body p {
    color: var(--text-soft);
    font-size: 0.94rem;
  }

  .work-body .text-link {
    margin-top: auto;
    padding-top: 6px;
  }
</style>
