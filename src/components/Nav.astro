---
import Icon from './Icon.astro';
import type { Locale } from '../i18n';
import { ui } from '../i18n';

interface Props {
  locale: Locale;
  prefix: string;
}

const { locale, prefix } = Astro.props;
const t = ui[locale];
const links = [
  { href: `${prefix}/`, label: t.nav.home },
  { href: `${prefix}/about/`, label: t.nav.about },
  { href: `${prefix}/works/`, label: t.nav.works },
  { href: `${prefix}/thoughts/`, label: t.nav.thoughts },
];
const otherHref = locale === 'zh' ? '/en/' : '/';
const otherLabel = locale === 'zh' ? 'EN' : '中文';
---

<header class="nav">
  <div class="container nav-inner">
    <a class="brand" href={`${prefix}/`} aria-label={t.site.name}>
      <span class="brand-dot"></span>
      <span class="brand-name">{t.site.name}</span>
    </a>

    <nav class="nav-links" aria-label={t.site.name}>
      {links.map((link) => (
        <a href={link.href}>{link.label}</a>
      ))}
    </nav>

    <div class="nav-actions">
      <a class="nav-lang" href={otherHref}>{otherLabel}</a>
      <a
        class="icon-btn nav-gh"
        href="https://github.com/lordestar"
        target="_blank"
        rel="noreferrer"
        aria-label="GitHub"
      >
        <Icon name="github" size={18} />
      </a>
      <button class="icon-btn nav-toggle" type="button" aria-label="Menu" aria-expanded="false">
        <Icon name="menu" size={20} />
      </button>
    </div>
  </div>
</header>

<style>
  .nav {
    position: fixed;
    inset: 0 0 auto;
    z-index: 50;
    height: var(--nav-h);
    background: rgba(13, 15, 14, 0.72);
    border-bottom: 1px solid var(--border-soft);
    backdrop-filter: blur(18px) saturate(1.3);
    -webkit-backdrop-filter: blur(18px) saturate(1.3);
  }

  .nav-inner {
    height: 100%;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 24px;
  }

  .brand {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 1.08rem;
    letter-spacing: 0;
  }

  .brand-dot {
    width: 9px;
    height: 9px;
    border-radius: 50%;
    background: var(--coral);
    box-shadow: 0 0 0 4px rgba(240, 138, 111, 0.14);
  }

  .nav-links {
    display: flex;
    align-items: center;
    gap: 28px;
    font-size: 0.92rem;
    color: var(--text-soft);
  }

  .nav-links a {
    position: relative;
    padding-block: 6px;
    transition: color 0.25s var(--ease-out);
  }

  .nav-links a::after {
    content: '';
    position: absolute;
    left: 0;
    bottom: 0;
    width: 100%;
    height: 1px;
    background: var(--aqua);
    transform: scaleX(0);
    transform-origin: left;
    transition: transform 0.3s var(--ease-out);
  }

  .nav-links a:hover {
    color: var(--text);
  }

  .nav-links a:hover::after {
    transform: scaleX(1);
  }

  .nav-actions {
    display: flex;
    align-items: center;
    gap: 10px;
  }

  .nav-lang {
    font-family: var(--font-mono);
    font-size: 0.76rem;
    color: var(--text-soft);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    height: 38px;
    padding-inline: 12px;
    display: inline-flex;
    align-items: center;
    transition: color 0.25s var(--ease-out), border-color 0.25s var(--ease-out);
  }

  .nav-lang:hover {
    color: var(--aqua);
    border-color: rgba(127, 200, 192, 0.5);
  }

  .nav-toggle {
    display: none;
  }

  @media (max-width: 760px) {
    .nav-links {
      position: fixed;
      top: var(--nav-h);
      right: 12px;
      left: 12px;
      flex-direction: column;
      align-items: stretch;
      gap: 0;
      padding: 10px;
      background: rgba(20, 23, 21, 0.96);
      border: 1px solid var(--border);
      border-radius: var(--radius);
      backdrop-filter: blur(24px);
      -webkit-backdrop-filter: blur(24px);
      opacity: 0;
      pointer-events: none;
      transform: translateY(-8px);
      transition: opacity 0.28s var(--ease-out), transform 0.28s var(--ease-out);
    }

    .nav-links.is-open {
      opacity: 1;
      pointer-events: auto;
      transform: none;
    }

    .nav-links a {
      padding: 14px 12px;
      border-bottom: 1px solid var(--border-soft);
    }

    .nav-links a:last-child {
      border-bottom: 0;
    }

    .nav-links a::after {
      display: none;
    }

    .nav-toggle {
      display: inline-flex;
    }
  }
</style>

<script>
  const toggle = document.querySelector<HTMLButtonElement>('.nav-toggle');
  const links = document.querySelector<HTMLElement>('.nav-links');
  if (toggle && links) {
    toggle.addEventListener('click', () => {
      const open = links.classList.toggle('is-open');
      toggle.setAttribute('aria-expanded', String(open));
      toggle.innerHTML = open
        ? '<svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M18 6 6 18"/><path d="m6 6 12 12"/></svg>'
        : '<svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><line x1="4" x2="20" y1="6" y2="6"/><line x1="4" x2="20" y1="12" y2="12"/><line x1="4" x2="20" y1="18" y2="18"/></svg>';
    });
    links.querySelectorAll('a').forEach((link) => {
      link.addEventListener('click', () => {
        links.classList.remove('is-open');
        toggle.setAttribute('aria-expanded', 'false');
      });
    });
  }
</script>

