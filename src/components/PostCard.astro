---
import Icon from './Icon.astro';
import type { Locale } from '../i18n';
import { ui } from '../i18n';

interface Props {
  entry: {
    id: string;
    data: {
      title: string;
      date: Date;
      summary: string;
      tags: string[];
    };
  };
  locale: Locale;
  prefix: string;
}

const { entry, locale, prefix } = Astro.props;
const t = ui[locale];
const slug = entry.id.replace(/^(zh|en)\//, '').replace(/\.md$/, '');
const dateLabel = new Intl.DateTimeFormat(locale === 'zh' ? 'zh-CN' : 'en-US', {
  year: 'numeric',
  month: 'short',
  day: 'numeric',
}).format(entry.data.date);
---

<article class="post-card glass" data-reveal>
  <div class="post-meta">
    <span class="post-date">{dateLabel}</span>
    {entry.data.tags.slice(0, 3).map((tag) => (
      <span class="tag">{tag}</span>
    ))}
  </div>
  <h3>
    <a href={`${prefix}/thoughts/${slug}/`}>{entry.data.title}</a>
  </h3>
  <p>{entry.data.summary}</p>
  <a class="text-link" href={`${prefix}/thoughts/${slug}/`}>
    {t.thoughts.readMore}
    <Icon name="arrow-right" size={15} />
  </a>
</article>

<style>
  .post-card {
    display: flex;
    flex-direction: column;
    gap: 12px;
    padding: 22px;
    min-width: 0;
  }

  .post-meta {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 8px;
    font-family: var(--font-mono);
    font-size: 0.7rem;
    color: var(--muted);
  }

  .post-card h3 {
    font-family: var(--font-display);
    font-size: 1.18rem;
    font-weight: 650;
    letter-spacing: 0;
    line-height: 1.25;
  }

  .post-card h3 a:hover {
    color: var(--aqua);
  }

  .post-card p {
    color: var(--text-soft);
    font-size: 0.94rem;
    flex: 1;
  }

  .post-card .text-link {
    margin-top: 6px;
  }
</style>
