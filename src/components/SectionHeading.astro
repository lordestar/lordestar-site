---
import Icon from './Icon.astro';

interface Props {
  eyebrow: string;
  title: string;
  ctaHref?: string;
  ctaLabel?: string;
}

const { eyebrow, title, ctaHref, ctaLabel } = Astro.props;
---

<div class="section-head" data-reveal>
  <div>
    <span class="eyebrow">{eyebrow}</span>
    <h2>{title}</h2>
  </div>
  {ctaHref && ctaLabel && (
    <a class="text-link" href={ctaHref}>
      {ctaLabel}
      <Icon name="arrow-right" size={16} />
    </a>
  )}
</div>

