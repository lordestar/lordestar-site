---
import type { PostItem } from '../../lib/data';

interface Props {
  values?: PostItem; // 编辑时传入
  submitLabel: string;
}

const { values, submitLabel } = Astro.props;
const d = values?.data;
const fmtDate = (date?: Date) =>
  date ? date.toISOString().slice(0, 10) : new Date().toISOString().slice(0, 10);
const tagsText = d?.tags.join(', ') ?? '';
---

<form class="admin-form" method="post">
  <div class="admin-row">
    <div class="admin-field">
      <label>语言 Locale</label>
      <select name="locale">
        <option value="zh" selected={!values || !values.id.startsWith('en')}>中文 zh</option>
        <option value="en" selected={values?.id.startsWith('en')}>English en</option>
      </select>
    </div>
    <div class="admin-field">
      <label>Slug（URL 标识，如 hello-world）</label>
      <input
        type="text"
        name="slug"
        required
        pattern="[a-z0-9][a-z0-9-]*"
        placeholder="hello-world"
        value={values?.id.split('/')[1] ?? ''}
      />
    </div>
  </div>

  <div class="admin-field">
    <label>标题 Title</label>
    <input type="text" name="title" required placeholder="文章标题" value={d?.title ?? ''} />
  </div>

  <div class="admin-field">
    <label>日期 Date</label>
    <input type="date" name="date" required value={fmtDate(d?.date)} />
  </div>

  <div class="admin-field">
    <label>摘要 Summary</label>
    <input type="text" name="summary" placeholder="一句话摘要" value={d?.summary ?? ''} />
  </div>

  <div class="admin-field">
    <label>标签 Tags（用逗号分隔）</label>
    <input type="text" name="tags" placeholder="音乐, 日常" value={tagsText} />
  </div>

  <div class="admin-field">
    <label>正文 Body（Markdown）</label>
    <textarea name="body" placeholder="支持 Markdown 语法…">{values?.body ?? ''}</textarea>
  </div>

  <div>
    <button class="admin-btn" type="submit" style="height:40px;padding:0 22px">{submitLabel}</button
    >
    <a class="admin-btn" href="/admin/posts/" style="margin-left:10px">取消</a>
  </div>
</form>
