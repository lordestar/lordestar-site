---
import Icon from './Icon.astro';
import type { Locale } from '../i18n';
import { ui } from '../i18n';

interface Props {
  locale: Locale;
  prefix: string;
}

const { locale, prefix } = Astro.props;
const t = ui[locale];
const year = new Date().getFullYear();
const otherHref = locale === 'zh' ? '/en/' : '/';
const otherLabel = locale === 'zh' ? 'EN' : '中文';
---

<footer class="footer">
  <div class="container footer-inner">
    <div>
      <p class="footer-line">{t.site.name} · {t.footer.line}</p>
      <p class="footer-copy">© {year} lordestar. {t.footer.rights}</p>
    </div>

    <nav class="footer-nav" aria-label="lordestar">
      <a href={`${prefix}/`}>{t.nav.home}</a>
      <a href={`${prefix}/journal/`}>{t.journal.allTitle}</a>
      <a href={`${prefix}/diary/`}>{t.nav.diary}</a>
      <a href="/app/new/">✎ {t.app.new}</a>
    </nav>

    <div class="footer-actions">
      <a class="footer-lang" href={otherHref}>{otherLabel}</a>
      <a
        class="icon-btn"
        href="https://github.com/lordestar"
        target="_blank"
        rel="noreferrer"
        aria-label="GitHub"
      >
        <Icon name="github" size={18} />
      </a>
      <a class="icon-btn" href="mailto:hello@lordestar.dev" aria-label="Email">
        <Icon name="mail" size={18} />
      </a>
    </div>
  </div>
</footer>

<style>
  .footer {
    border-top: 1px solid var(--border-soft);
    padding: 42px 0;
    margin-top: 40px;
  }

  .footer-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 24px;
    flex-wrap: wrap;
  }

  .footer-line {
    font-family: var(--font-mono);
    font-size: 0.72rem;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: var(--muted);
  }

  .footer-copy {
    margin-top: 6px;
    font-size: 0.85rem;
    color: var(--muted);
  }

  .footer-nav {
    display: flex;
    gap: 18px;
  }

  .footer-nav a {
    color: var(--text-soft);
    font-size: 0.9rem;
    transition: color 0.2s;
  }

  .footer-nav a:hover {
    color: var(--aqua);
  }

  .footer-actions {
    display: flex;
    gap: 10px;
    align-items: center;
  }

  .footer-lang {
    font-family: var(--font-mono);
    font-size: 0.76rem;
    color: var(--text-soft);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    height: 34px;
    padding-inline: 12px;
    display: inline-flex;
    align-items: center;
    transition:
      color 0.25s,
      border-color 0.25s;
  }

  .footer-lang:hover {
    color: var(--aqua);
    border-color: rgba(127, 200, 192, 0.5);
  }

  @media (max-width: 640px) {
    .footer-inner {
      flex-direction: column;
      align-items: flex-start;
    }
  }
</style>
