---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from './PageHero.astro';
import WorkCard from './WorkCard.astro';
import type { Locale } from '../i18n';
import { ui, entriesFor } from '../i18n';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = ui[locale];
const prefix = locale === 'zh' ? '' : '/en';
const works = entriesFor(await getCollection('works'), locale).sort((a, b) =>
  b.data.date.getTime() - a.data.date.getTime(),
);
const musicCount = works.filter((work) => work.data.type === 'music').length;
const codeCount = works.filter((work) => work.data.type === 'code').length;
---

<BaseLayout locale={locale} title={`${t.works.title} · lordestar`}>
  <PageHero eyebrow="works" title={t.works.title} subtitle={t.works.subtitle} />

  <section class="section works-section">
    <div class="container">
      <div class="filters" data-reveal>
        <button class="filter-btn is-active" type="button" data-filter="all">
          {t.works.all}
          <span class="filter-count">{works.length}</span>
        </button>
        <button class="filter-btn" type="button" data-filter="music">
          {t.works.music}
          <span class="filter-count">{musicCount}</span>
        </button>
        <button class="filter-btn" type="button" data-filter="code">
          {t.works.code}
          <span class="filter-count">{codeCount}</span>
        </button>
      </div>

      {works.length > 0 ? (
        <div class="works-grid">
          {works.map((work, index) => (
            <div class="work-slot" style={`--reveal-delay: ${(index % 2) * 90}ms`}>
              <WorkCard entry={work} locale={locale} prefix={prefix} />
            </div>
          ))}
        </div>
      ) : (
        <p class="empty">{t.works.empty}</p>
      )}
    </div>
  </section>
</BaseLayout>

<style>
  .works-section {
    padding-top: 0;
  }

  .filters {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
    margin-bottom: 32px;
  }

  .filter-btn {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    height: 40px;
    padding-inline: 14px;
    border: 1px solid var(--border);
    border-radius: var(--radius);
    background: var(--panel);
    font-family: var(--font-mono);
    font-size: 0.78rem;
    color: var(--text-soft);
    transition: background 0.25s var(--ease-out), border-color 0.25s var(--ease-out), color 0.25s var(--ease-out);
  }

  .filter-btn:hover {
    border-color: rgba(127, 200, 192, 0.5);
  }

  .filter-btn.is-active {
    background: var(--aqua);
    border-color: transparent;
    color: #10201d;
  }

  .filter-count {
    font-size: 0.68rem;
    opacity: 0.75;
  }

  .works-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 20px;
  }

  .work-slot.is-hidden {
    display: none;
  }

  .empty {
    color: var(--muted);
  }

  @media (max-width: 860px) {
    .works-grid {
      grid-template-columns: 1fr;
    }
  }
</style>

<script>
  const buttons = Array.from(document.querySelectorAll<HTMLButtonElement>('.filter-btn'));
  const slots = Array.from(document.querySelectorAll<HTMLElement>('.work-slot'));

  buttons.forEach((button) => {
    button.addEventListener('click', () => {
      const filter = button.dataset.filter ?? 'all';
      buttons.forEach((btn) => btn.classList.toggle('is-active', btn === button));
      slots.forEach((slot) => {
        const card = slot.querySelector<HTMLElement>('.work-card');
        const type = card?.dataset.type ?? '';
        slot.classList.toggle('is-hidden', filter !== 'all' && type !== filter);
      });
    });
  });
</script>

