---
import type { Locale } from '../../i18n';
import { ui } from '../../i18n';

interface Props {
  locale: Locale;
  mode: 'new' | 'edit';
  initial?: {
    dbId?: number;
    kind?: 'song' | 'text' | 'photo';
    title?: string;
    artist?: string;
    cover?: string;
    songUrl?: string;
    note?: string;
    images?: string[];
    public?: boolean;
  };
}

const { locale, mode, initial } = Astro.props;
const t = ui[locale];
const initialKind = initial?.kind ?? 'song';
const isEdit = mode === 'edit';
const apiUrl = isEdit ? `/api/diary/${initial?.dbId}` : '/api/diary';
---

<div
  id="rf"
  class="rf"
  data-api={apiUrl}
  data-mode={mode}
  data-initial-kind={initial?.kind ?? 'song'}
  data-initial-images={JSON.stringify(initial?.images ?? [])}
>
  <!-- 反馈消息 -->
  <div id="rf-msg" class="app-msg" hidden></div>

  <!-- 类型 Tab -->
  <div class="app-tabs">
    <button class="app-tab is-active" type="button" data-rf-tab="song">{t.app.song}</button>
    <button class="app-tab" type="button" data-rf-tab="text">{t.app.text}</button>
    <button class="app-tab" type="button" data-rf-tab="photo">{t.app.photo}</button>
  </div>

  <!-- 听歌 -->
  <div data-rf-pane="song" class="app-card">
    <div class="app-field">
      <label>{t.app.song}</label>
      {
        isEdit ? (
          <input
            type="text"
            data-rf-song-title
            value={initial?.title ?? ''}
            placeholder={t.app.title}
          />
        ) : (
          <textarea data-rf-song-text placeholder={t.app.songHint} />
        )
      }
      {
        !isEdit && (
          <button class="app-btn" type="button" data-rf-resolve>
            {t.app.resolve}
          </button>
        )
      }
      {!isEdit && <p class="app-hint" data-rf-resolve-hint hidden />}
    </div>
    {
      isEdit && (
        <div class="app-field">
          <label>artist / cover / url</label>
          <input
            type="text"
            data-rf-song-artist
            value={initial?.artist ?? ''}
            placeholder="artist"
          />
          <input
            type="text"
            data-rf-song-cover
            value={initial?.cover ?? ''}
            placeholder="cover url"
          />
          <input
            type="text"
            data-rf-song-url
            value={initial?.songUrl ?? ''}
            placeholder="song url"
          />
        </div>
      )
    }
    {!isEdit && <div class="rf-preview" data-rf-preview hidden />}
    <div class="app-field">
      <label>{t.app.note}</label>
      <input type="text" data-rf-song-note value={initial?.note ?? ''} />
    </div>
  </div>

  <!-- 感想 -->
  <div data-rf-pane="text" class="app-card" hidden>
    <div class="app-field">
      <label>{t.app.text}</label>
      <textarea data-rf-text-content placeholder={t.app.content}
        >{initial?.kind === 'text' ? initial.note : ''}</textarea
      >
    </div>
  </div>

  <!-- 照片 -->
  <div data-rf-pane="photo" class="app-card" hidden>
    <div class="app-field">
      <label>{t.app.photo}</label>
      <input type="file" accept="image/*" multiple capture="environment" data-rf-photo-file />
      <p class="app-hint">{t.app.photoHint}</p>
    </div>
    <div class="rf-thumbs" data-rf-thumbs></div>
    <div class="app-field">
      <label>{t.app.note}</label>
      <textarea data-rf-photo-note placeholder={t.app.content}
        >{initial?.kind === 'photo' ? initial.note : ''}</textarea
      >
    </div>
  </div>

  <!-- 公开 + 保存 -->
  <label class="rf-public">
    <input type="checkbox" data-rf-public checked={initial?.public ?? false} />
    <span>{t.app.public}</span>
    <span class="app-hint">{t.app.privateHint}</span>
  </label>

  <button class="app-btn rf-save" type="button" data-rf-save style="width:100%">
    {isEdit ? t.app.save : t.app.save}
  </button>
</div>

<script>
  import type { Locale } from '../../i18n';
  import { ui } from '../../i18n';

  interface ThisRoot extends HTMLElement {
    __rf?: {
      kind: 'song' | 'text' | 'photo';
      images: string[];
      edit: boolean;
      dbId?: number;
      song: { title: string; artist: string; cover: string; songUrl: string; ncmId: number | null };
    };
  }

  const root = document.querySelector<ThisRoot>('#rf');
  if (!root) throw new Error('rf root missing');

  const t = ui[(document.documentElement.lang === 'zh-CN' ? 'zh' : 'en') as Locale];
  const api = root.dataset.api ?? '/api/diary';
  const edit = root.dataset.mode === 'edit';

  // 初始类型与已有图片（编辑模式）
  const initialKind = (root.dataset.initialKind ?? 'song') as 'song' | 'text' | 'photo';
  let initialImages: string[] = [];
  try {
    const parsed = JSON.parse(root.dataset.initialImages ?? '[]');
    if (Array.isArray(parsed)) initialImages = parsed.map(String);
  } catch {
    initialImages = [];
  }

  const state = {
    kind: initialKind,
    images: [...initialImages],
    song: { title: '', artist: '', cover: '', songUrl: '', ncmId: null as number | null },
  };

  const $ = <T extends HTMLElement = HTMLElement>(sel: string): T | null => root.querySelector(sel);
  const msg = (text: string, ok = false) => {
    const el = $<HTMLElement>('#rf-msg');
    if (!el) return;
    el.textContent = text;
    el.hidden = false;
    el.className = `app-msg ${ok ? 'app-msg-ok' : 'app-msg-error'}`;
    setTimeout(() => (el.hidden = true), 4000);
  };

  // ── Tabs ──
  const tabs = Array.from(root.querySelectorAll<HTMLButtonElement>('[data-rf-tab]'));
  const panes = Array.from(root.querySelectorAll<HTMLElement>('[data-rf-pane]'));
  const setTab = (kind: string) => {
    state.kind = kind as typeof state.kind;
    tabs.forEach((b) => b.classList.toggle('is-active', b.dataset.rfTab === kind));
    panes.forEach((p) => (p.hidden = p.dataset.rfPane !== kind));
  };
  tabs.forEach((b) => b.addEventListener('click', () => setTab(b.dataset.rfTab ?? 'song')));

  // ── 听歌：解析 ──
  const resolveBtn = $<HTMLButtonElement>('[data-rf-resolve]');
  const previewEl = $<HTMLElement>('[data-rf-preview]');
  const hintEl = $<HTMLElement>('[data-rf-resolve-hint]');

  async function resolveSong(text: string) {
    if (hintEl) {
      hintEl.hidden = false;
      hintEl.textContent = t.app.resolving;
    }
    const resp = await fetch('/api/ncm/resolve', {
      method: 'POST',
      headers: { 'content-type': 'application/json' },
      body: JSON.stringify({ text }),
    });
    const data = (await resp.json()) as {
      ok?: boolean;
      song?: { title: string; artist: string; cover: string; songUrl: string; id?: number };
      error?: string;
    };
    if (!resp.ok || !data.ok || !data.song) {
      if (hintEl) {
        hintEl.textContent = data.error || t.app.resolveFail;
        hintEl.style.color = 'var(--coral)';
      }
      return;
    }
    state.song = {
      title: data.song.title,
      artist: data.song.artist,
      cover: data.song.cover,
      songUrl: data.song.songUrl,
      ncmId: data.song.id ?? null,
    };
    if (hintEl) hintEl.hidden = true;
    if (previewEl) {
      previewEl.hidden = false;
      previewEl.innerHTML = '';
      const img = document.createElement('img');
      if (state.song.cover) img.src = state.song.cover;
      const info = document.createElement('div');
      const titleEl = document.createElement('strong');
      titleEl.textContent = `${state.song.title} · ${state.song.artist}`;
      info.appendChild(titleEl);
      previewEl.appendChild(img);
      previewEl.appendChild(info);
    }
  }

  resolveBtn?.addEventListener('click', async () => {
    const text = $<HTMLTextAreaElement>('[data-rf-song-text]')?.value ?? '';
    if (!text.trim()) {
      msg(t.app.required);
      return;
    }
    resolveBtn.disabled = true;
    try {
      await resolveSong(text);
    } finally {
      resolveBtn.disabled = false;
    }
  });

  // ── 照片：上传 ──
  const fileInput = $<HTMLInputElement>('[data-rf-photo-file]');
  const thumbsEl = $<HTMLElement>('[data-rf-thumbs]');

  // 编辑模式：渲染已有图片缩略图
  if (thumbsEl && state.images.length > 0) {
    for (const src of state.images) {
      const wrap = document.createElement('div');
      wrap.className = 'rf-thumb';
      const img = document.createElement('img');
      img.src = src;
      img.alt = '';
      wrap.appendChild(img);
      thumbsEl.appendChild(wrap);
    }
  }

  fileInput?.addEventListener('change', async () => {
    const files = fileInput.files ? Array.from(fileInput.files) : [];
    if (files.length === 0) return;
    fileInput.disabled = true;
    try {
      for (const file of files) {
        const form = new FormData();
        form.append('file', file);
        const resp = await fetch('/api/upload', { method: 'POST', body: form });
        const data = (await resp.json()) as { url?: string; error?: string };
        if (!resp.ok || !data.url) {
          msg(`${t.app.uploadFail}: ${data.error || ''}`);
          continue;
        }
        state.images.push(data.url);
        if (thumbsEl) {
          const wrap = document.createElement('div');
          wrap.className = 'rf-thumb';
          const img = document.createElement('img');
          img.src = data.url;
          img.alt = '';
          wrap.appendChild(img);
          thumbsEl.appendChild(wrap);
        }
      }
    } finally {
      fileInput.disabled = false;
      fileInput.value = '';
    }
  });

  // ── 保存 ──
  const saveBtn = $<HTMLButtonElement>('[data-rf-save]');
  const publicEl = $<HTMLInputElement>('[data-rf-public]');

  saveBtn?.addEventListener('click', async () => {
    let payload: Record<string, unknown>;
    if (state.kind === 'song') {
      const title = edit
        ? ($<HTMLInputElement>('[data-rf-song-title]')?.value ?? '').trim()
        : state.song.title;
      const artist = edit
        ? ($<HTMLInputElement>('[data-rf-song-artist]')?.value ?? '').trim()
        : state.song.artist;
      const cover = edit
        ? ($<HTMLInputElement>('[data-rf-song-cover]')?.value ?? '').trim()
        : state.song.cover;
      const songUrl = edit
        ? ($<HTMLInputElement>('[data-rf-song-url]')?.value ?? '').trim()
        : state.song.songUrl;
      const note = ($<HTMLInputElement>('[data-rf-song-note]')?.value ?? '').trim();
      if (!title && !edit) {
        msg(t.app.required);
        return;
      }
      payload = {
        kind: 'song',
        title: title || '未命名',
        artist,
        album: '',
        cover,
        ncmId: state.song.ncmId,
        songUrl,
        note,
        public: publicEl?.checked ?? false,
      };
    } else if (state.kind === 'text') {
      const content = ($<HTMLTextAreaElement>('[data-rf-text-content]')?.value ?? '').trim();
      if (!content) {
        msg(t.app.required);
        return;
      }
      payload = {
        kind: 'text',
        title: content.slice(0, 20) || '未命名',
        note: content,
        public: publicEl?.checked ?? false,
      };
    } else {
      const note = ($<HTMLTextAreaElement>('[data-rf-photo-note]')?.value ?? '').trim();
      if (state.images.length === 0) {
        msg(t.app.required);
        return;
      }
      payload = {
        kind: 'photo',
        title: note.slice(0, 20) || '照片',
        note,
        images: state.images,
        public: publicEl?.checked ?? false,
      };
    }

    saveBtn.disabled = true;
    try {
      const resp = await fetch(api, {
        method: edit ? 'PUT' : 'POST',
        headers: { 'content-type': 'application/json' },
        body: JSON.stringify(payload),
      });
      if (!resp.ok) {
        const data = (await resp.json().catch(() => null)) as { error?: string } | null;
        msg(data?.error || t.app.uploadFail);
        return;
      }
      msg(t.app.saved, true);
      if (!edit) {
        setTimeout(() => {
          window.location.href = '/app/records/';
        }, 700);
      }
    } finally {
      saveBtn.disabled = false;
    }
  });

  // ── 初始 Tab（编辑模式按记录类型） ──
  setTab(initialKind);

  // ── Web Share Target：?share= 文本 → 自动解析 ──
  const params = new URLSearchParams(window.location.search);
  const shareText = params.get('share');
  if (!edit && shareText) {
    setTab('song');
    const textarea = $<HTMLTextAreaElement>('[data-rf-song-text]');
    if (textarea) {
      textarea.value = shareText;
      resolveBtn?.click();
    }
  }
</script>

<style>
  .rf-preview {
    display: flex;
    align-items: center;
    gap: 14px;
    padding: 12px;
    border: 1px solid var(--border);
    border-radius: 10px;
    background: rgba(255, 255, 255, 0.03);
    margin-bottom: 14px;
  }

  .rf-preview img {
    width: 64px;
    height: 64px;
    border-radius: 8px;
    object-fit: cover;
  }

  .rf-thumbs {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
    margin-bottom: 14px;
  }

  .rf-thumb {
    width: 84px;
    height: 84px;
    border-radius: 8px;
    overflow: hidden;
    border: 1px solid var(--border);
  }

  .rf-thumb img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .rf-public {
    display: flex;
    align-items: center;
    gap: 10px;
    margin: 4px 0 16px;
    font-size: 0.95rem;
    color: var(--text-soft);
  }

  .rf-public input {
    width: 18px;
    height: 18px;
    accent-color: var(--aqua);
  }
</style>
