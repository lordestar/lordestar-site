---
import Icon from './Icon.astro';

interface PhotoItem {
  src: string;
  poster?: string;
  caption?: string;
}

interface Props {
  images: PhotoItem[];
  locale?: 'zh' | 'en';
}

const { images, locale = 'zh' } = Astro.props;
const widths = [9, 7, 8, 10, 6, 9, 8, 7, 10, 8, 9, 7];
const openLabel = locale === 'zh' ? '查看大图' : 'View photo';
const closeLabel = locale === 'zh' ? '关闭' : 'Close';
---

<div class="galaxy-wrap">
  <div class="galaxy" data-galaxy>
    <div class="galaxy-scrim"></div>
    {
      images.map((item, index) => (
        <figure
          class="galaxy-item"
          data-galaxy-item
          data-index={index}
          data-src={item.src}
          data-caption={item.caption ?? ''}
          data-poster={item.poster ?? ''}
          style={`width: ${widths[index % widths.length]}%`}
          role="button"
          tabindex="0"
          aria-label={openLabel}
        >
          <img
            src={item.poster ?? item.src}
            alt=""
            loading="lazy"
            decoding="async"
            draggable="false"
          />
          <span class="galaxy-overlay" aria-hidden="true" />
        </figure>
      ))
    }
  </div>
  <div class="galaxy-slot">
    <slot />
  </div>
  <div class="galaxy-viewer" data-galaxy-viewer hidden aria-hidden="true">
    <span class="viewer-index" aria-hidden="true">
      <em data-viewer-index>00</em>
      <i>/</i>
      <em data-viewer-total>00</em>
    </span>
    <button class="viewer-close" type="button" data-viewer-close aria-label={closeLabel}>
      <Icon name="close" size={20} />
    </button>
    <figure class="viewer-frame">
      <img data-viewer-img alt="" />
      <figcaption class="viewer-caption" data-viewer-caption></figcaption>
    </figure>
  </div>
</div>

<script>
  import { ImageGalaxy } from './image-galaxy/engine';

  const root = document.querySelector<HTMLElement>('[data-galaxy]');
  if (root) {
    const items = Array.from(root.querySelectorAll<HTMLElement>('[data-galaxy-item]'));
    const overlays = items.map((item) => item.querySelector<HTMLElement>('.galaxy-overlay'));
    const galaxy = new ImageGalaxy(root, items, overlays);
    const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

    const viewer = document.querySelector<HTMLElement>('[data-galaxy-viewer]');
    const viewerImg = viewer?.querySelector<HTMLImageElement>('[data-viewer-img]');
    const viewerCaption = viewer?.querySelector<HTMLElement>('[data-viewer-caption]');
    const viewerClose = viewer?.querySelector<HTMLButtonElement>('[data-viewer-close]');
    const viewerIndex = viewer?.querySelector<HTMLElement>('[data-viewer-index]');
    const viewerTotal = viewer?.querySelector<HTMLElement>('[data-viewer-total]');
    let viewerOpen = false;
    let finishTimer: ReturnType<typeof setTimeout> | null = null;
    let lastFocusedItem: HTMLElement | null = null;

    const inViewport = (el: HTMLElement) => {
      const rect = el.getBoundingClientRect();
      return rect.bottom > 0 && rect.top < window.innerHeight;
    };

    // FLIP transition — the enlarged image grows out of the clicked
    // thumbnail and flies back into it on close (easeOutQuint curve).
    const EASE = 'cubic-bezier(0.22, 1, 0.36, 1)';
    const DURATION = 560;

    const openViewer = (item: HTMLElement, index: number) => {
      const img = item.querySelector<HTMLImageElement>('img');
      // The preview source is always the full file (animated GIF included);
      // the thumbnail may show a static poster instead.
      const src = item.dataset.src ?? img?.getAttribute('src');
      if (!src || !viewer || !viewerImg || viewerOpen) return;
      const caption = item.dataset.caption ?? '';

      // Load dimensions from the (lightweight) poster when available — the
      // animated GIF itself only starts loading once the preview opens.
      const pre = new Image();
      pre.src = item.dataset.poster || src;
      pre.onload = () => {
        if (!viewer || !viewerImg || viewerOpen) return;
        const natW = pre.naturalWidth || 1;
        const natH = pre.naturalHeight || 1;
        // Keep the enlarged photo comfortably inside the viewport so the
        // caption below it stays visible — ~half the screen height max.
        const maxW = Math.min(window.innerWidth * 0.72, 640);
        const maxH = window.innerHeight * 0.5;
        const s = Math.min(maxW / natW, maxH / natH, 1);
        const w = Math.round(natW * s);
        const h = Math.round(natH * s);

        viewerImg.src = src;
        viewerImg.alt = caption || img?.alt || '';
        viewerImg.style.width = `${w}px`;
        viewerImg.style.height = `${h}px`;
        if (viewerCaption) viewerCaption.textContent = caption;

        viewer.hidden = false;
        viewer.setAttribute('aria-hidden', 'false');
        viewerOpen = true;
        lastFocusedItem = item;
        galaxy.stop();
        if (viewerIndex) viewerIndex.textContent = String(index + 1).padStart(2, '0');
        if (viewerTotal) viewerTotal.textContent = String(items.length).padStart(2, '0');
        viewerCaption?.classList.remove('is-visible');

        if (reduced) {
          viewer.classList.add('is-open');
          viewerCaption?.classList.add('is-visible');
          viewerClose?.focus();
          return;
        }

        // Start from the thumbnail's on-screen box.
        const from = item.getBoundingClientRect();
        const to = viewerImg.getBoundingClientRect();
        const dx = from.left - to.left;
        const dy = from.top - to.top;
        const sx = from.width / to.width;
        const sy = from.height / to.height;
        viewerImg.style.transition = 'none';
        viewerImg.style.transform = `translate(${dx}px, ${dy}px) scale(${sx}, ${sy})`;
        viewerImg.style.opacity = '0';
        viewer.classList.remove('is-open');

        // Next frame: animate to the centered, full-size position.
        requestAnimationFrame(() => {
          requestAnimationFrame(() => {
            if (!viewerOpen) return;
            viewerImg.style.transition = `transform ${DURATION}ms ${EASE}, opacity 360ms ease`;
            viewerImg.style.transform = 'none';
            viewerImg.style.opacity = '1';
            viewer.classList.add('is-open');
            window.setTimeout(() => viewerCaption?.classList.add('is-visible'), 170);
          });
        });
        viewerClose?.focus();
      };
      pre.src = src;
    };

    const finishClose = () => {
      if (!viewer || !viewerImg) return;
      viewer.hidden = true;
      viewer.setAttribute('aria-hidden', 'true');
      viewerImg.style.transition = 'none';
      viewerImg.style.transform = 'none';
      viewerImg.style.opacity = '1';
      // Only return focus to the thumbnail if it is still on screen — the
      // page may have scrolled while the preview was open.
      if (lastFocusedItem && inViewport(lastFocusedItem)) lastFocusedItem.focus();
      lastFocusedItem = null;
      if (!reduced && inViewport(root)) galaxy.start();
    };

    const closeViewer = () => {
      if (!viewer || !viewerImg || !viewerOpen) return;
      viewerOpen = false;
      viewerCaption?.classList.remove('is-visible');
      if (finishTimer) clearTimeout(finishTimer);

      if (reduced) {
        viewer.classList.remove('is-open');
        finishClose();
        return;
      }

      const thumbImg = lastFocusedItem?.querySelector<HTMLImageElement>('img');
      const from = viewerImg.getBoundingClientRect();
      const to = thumbImg ? thumbImg.getBoundingClientRect() : null;
      viewer.classList.remove('is-open');
      if (to && from.width > 0 && from.height > 0) {
        const dx = to.left - from.left;
        const dy = to.top - from.top;
        const sx = to.width / from.width;
        const sy = to.height / from.height;
        viewerImg.style.transition = `transform ${Math.round(DURATION * 0.86)}ms ${EASE}, opacity 300ms ease`;
        viewerImg.style.transform = `translate(${dx}px, ${dy}px) scale(${sx}, ${sy})`;
        viewerImg.style.opacity = '0';
        finishTimer = setTimeout(finishClose, Math.round(DURATION * 0.86));
      } else {
        viewerImg.style.transition = 'opacity 260ms ease';
        viewerImg.style.opacity = '0';
        finishTimer = setTimeout(finishClose, 280);
      }
    };

    root.addEventListener('click', (event) => {
      const item = (event.target as HTMLElement).closest<HTMLElement>('[data-galaxy-item]');
      if (item) openViewer(item, Number(item.dataset.index ?? 0));
    });

    root.addEventListener('keydown', (event) => {
      const item = (event.target as HTMLElement).closest<HTMLElement>('[data-galaxy-item]');
      if (!item || (event.key !== 'Enter' && event.key !== ' ')) return;
      event.preventDefault();
      openViewer(item, Number(item.dataset.index ?? 0));
    });

    viewerClose?.addEventListener('click', closeViewer);
    viewer?.addEventListener('click', (event) => {
      if (event.target === viewer) closeViewer();
    });
    document.addEventListener('keydown', (event) => {
      if (viewerOpen && event.key === 'Escape') closeViewer();
    });

    const io = new IntersectionObserver(
      ([entry]) => {
        if (reduced) {
          galaxy.stop();
          return;
        }
        if (entry.isIntersecting) galaxy.start();
        else galaxy.stop();
      },
      { threshold: 0.05 },
    );
    io.observe(root);

    const ro = new ResizeObserver(() => galaxy.layout());
    ro.observe(root);

    let lastWheel = 0;
    window.addEventListener(
      'wheel',
      (event) => {
        if (viewerOpen) return;
        const now = performance.now();
        if (now - lastWheel < 40) return;
        lastWheel = now;
        galaxy.addScroll(event.deltaY, Math.sign(event.deltaY));
      },
      { passive: true },
    );
  }
</script>

<style>
  .galaxy-wrap {
    position: relative;
    height: 100%;
    min-height: 420px;
  }

  .galaxy {
    position: absolute;
    inset: 0;
    overflow: hidden;
    perspective: 900px;
    background: var(--bg-raise);
  }

  .galaxy-scrim {
    position: absolute;
    inset: 0;
    z-index: 2;
    background:
      linear-gradient(
        180deg,
        rgba(13, 15, 14, 0.72),
        rgba(13, 15, 14, 0.18) 38%,
        rgba(13, 15, 14, 0.72)
      ),
      radial-gradient(120% 90% at 50% 42%, transparent 42%, rgba(13, 15, 14, 0.55));
    pointer-events: none;
  }

  .galaxy-item {
    position: absolute;
    aspect-ratio: 4 / 3;
    z-index: 1;
    margin: 0;
    overflow: hidden;
    border-radius: 6px;
    border: 1px solid rgba(255, 255, 255, 0.16);
    box-shadow: 0 14px 34px rgba(0, 0, 0, 0.42);
    will-change: transform;
    user-select: none;
    cursor: zoom-in;
  }

  .galaxy-item:focus-visible {
    outline: 2px solid var(--accent, #f2c94c);
    outline-offset: 3px;
  }

  .galaxy-item:nth-child(3n + 2) {
    aspect-ratio: 3 / 4;
  }

  .galaxy-item:nth-child(4n) {
    aspect-ratio: 1 / 1;
  }

  .galaxy-item img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    transition: filter 180ms ease;
  }

  .galaxy-item:hover img,
  .galaxy-item:focus-visible img {
    filter: brightness(1.14) saturate(1.06);
  }

  .galaxy-overlay {
    position: absolute;
    inset: 0;
    background: rgba(255, 255, 255, 0.18);
    pointer-events: none;
  }

  .galaxy-slot {
    position: relative;
    z-index: 3;
    height: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
    pointer-events: none;
  }

  .galaxy-slot > * {
    pointer-events: auto;
  }

  /* ── Viewer: shared-element (FLIP) lightbox ───────────────────────
     The overlay is a fixed, non-scrolling layer: wheel/touch events pass
     through to the page, so the background keeps scrolling while the
     enlarged photo stays pinned on screen. */
  .galaxy-viewer {
    position: fixed;
    inset: 0;
    z-index: 120;
    display: flex;
    padding: 24px;
    background: rgba(6, 8, 7, 0.78);
    backdrop-filter: blur(22px) saturate(1.1);
    -webkit-backdrop-filter: blur(22px) saturate(1.1);
    opacity: 0;
    transition: opacity 420ms ease;
  }

  .galaxy-viewer.is-open {
    opacity: 1;
  }

  .galaxy-viewer[hidden] {
    display: none;
  }

  .viewer-index {
    position: fixed;
    top: 20px;
    left: 24px;
    z-index: 1;
    display: inline-flex;
    align-items: baseline;
    gap: 7px;
    font-family: var(--font-mono);
    font-size: 0.72rem;
    letter-spacing: 0.14em;
    color: var(--muted);
    pointer-events: none;
  }

  .viewer-index em {
    font-style: normal;
    color: var(--text-soft);
  }

  .viewer-index i {
    font-style: normal;
    opacity: 0.5;
  }

  .viewer-close {
    position: fixed;
    top: 20px;
    right: 20px;
    z-index: 1;
    width: 44px;
    height: 44px;
    display: grid;
    place-items: center;
    border: 1px solid rgba(255, 255, 255, 0.2);
    border-radius: 999px;
    background: rgba(255, 255, 255, 0.08);
    color: var(--text);
    cursor: pointer;
    transition:
      background 180ms ease,
      transform 180ms ease;
  }

  .viewer-close:hover {
    background: rgba(255, 255, 255, 0.16);
    transform: scale(1.05);
  }

  .viewer-frame {
    /* margin:auto keeps the content centered while still scrollable when
       it overflows the viewer */
    margin: auto;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 16px;
  }

  .viewer-frame img {
    display: block;
    max-width: 72vw;
    max-height: 50vh;
    object-fit: contain;
    border: 1px solid rgba(255, 255, 255, 0.14);
    border-radius: 12px;
    background: #000;
    box-shadow: 0 34px 90px rgba(0, 0, 0, 0.6);
    will-change: transform, opacity;
  }

  .viewer-caption {
    max-width: 76vw;
    overflow-wrap: anywhere;
    font-size: 1rem;
    color: var(--text-soft);
    letter-spacing: 0.01em;
    text-align: center;
    opacity: 0;
    transform: translateY(14px);
    filter: blur(5px);
    transition:
      opacity 520ms cubic-bezier(0.22, 1, 0.36, 1) 140ms,
      transform 520ms cubic-bezier(0.22, 1, 0.36, 1) 140ms,
      filter 520ms cubic-bezier(0.22, 1, 0.36, 1) 140ms;
  }

  .viewer-caption.is-visible {
    opacity: 1;
    transform: none;
    filter: blur(0);
  }

  @media (max-width: 700px) {
    .galaxy-wrap {
      min-height: 380px;
    }

    .galaxy-item {
      width: 24% !important;
      aspect-ratio: 4 / 3 !important;
    }

    .galaxy-viewer {
      padding: 16px;
    }

    .viewer-close {
      top: 14px;
      right: 14px;
      width: 40px;
      height: 40px;
    }

    .viewer-index {
      top: 14px;
      left: 16px;
    }

    .viewer-frame img {
      max-height: 42vh;
    }
  }
</style>
