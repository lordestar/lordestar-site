---
import '@fontsource-variable/archivo';
import '@fontsource/ibm-plex-mono/400.css';
import '@fontsource/ibm-plex-mono/500.css';
import '../styles/global.css';
import Footer from '../components/Footer.astro';
import PwaHead from '../components/PwaHead.astro';
import type { Locale } from '../i18n';
import { ui } from '../i18n';

interface Props {
  locale: Locale;
  title: string;
  description?: string;
}

const { locale, title, description } = Astro.props;
const t = ui[locale];
const lang = locale === 'zh' ? 'zh-CN' : 'en';
const prefix = locale === 'zh' ? '' : '/en';
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description ?? t.site.description} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description ?? t.site.description} />
    <meta property="og:type" content="website" />
    <meta name="theme-color" content="#0d0f0e" />
    <PwaHead />
  </head>
  <body>
    <main id="main">
      <slot />
    </main>
    <Footer locale={locale} prefix={prefix} />
    <script>
      const revealEls = document.querySelectorAll('[data-reveal]');
      if ('IntersectionObserver' in window) {
        const io = new IntersectionObserver(
          (entries) => {
            for (const entry of entries) {
              if (entry.isIntersecting) {
                entry.target.classList.add('is-visible');
                io.unobserve(entry.target);
              }
            }
          },
          { threshold: 0.15, rootMargin: '0px 0px -8% 0px' },
        );
        revealEls.forEach((el) => io.observe(el));
      } else {
        revealEls.forEach((el) => el.classList.add('is-visible'));
      }
    </script>
    <style>
      .fab {
        position: fixed;
        right: 20px;
        bottom: calc(20px + env(safe-area-inset-bottom, 0px));
        z-index: 40;
        width: 54px;
        height: 54px;
        border-radius: 50%;
        background: var(--aqua);
        color: #10201d;
        display: grid;
        place-items: center;
        font-size: 1.35rem;
        font-weight: 700;
        box-shadow: 0 10px 26px rgba(0, 0, 0, 0.42);
        transition:
          transform 0.2s var(--ease-out),
          filter 0.2s;
      }

      .fab:hover {
        transform: translateY(-2px);
        filter: brightness(1.08);
      }

      @media (min-width: 900px) {
        .fab {
          width: 58px;
          height: 58px;
        }
      }
    </style>
  </body>
</html>
