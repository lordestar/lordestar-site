---
import AdminLayout from '../../components/admin/AdminLayout.astro';
import { isAuthed, verifyPassword, markAuthed } from '../../lib/admin';

// 登录后跳回来源页（App 入口 /app/new?from=...）
const from = Astro.url.searchParams.get('from');
const safeFrom = from && from.startsWith('/') ? from : '/admin/';

let error: string | null = null;

if (Astro.request.method === 'POST') {
  const form = await Astro.request.formData();
  const password = String(form.get('password') ?? '');
  if (verifyPassword(password)) {
    markAuthed(Astro.session);
    return Astro.redirect(safeFrom);
  }
  error = '密码不正确';
} else if (await isAuthed(Astro.session)) {
  return Astro.redirect(safeFrom);
}
---

<AdminLayout title="登录">
  <div style="max-width:380px;margin:10vh auto 0">
    <h1
      style="font-family:var(--font-display);font-size:1.5rem;font-weight:700;letter-spacing:0;margin-bottom:6px"
    >
      lordestar 后台
    </h1>
    <p style="color:var(--muted);font-size:0.9rem;margin-bottom:22px">输入密码登录</p>

    {
      error && (
        <div class="admin-error" style="margin-bottom:14px">
          {error}
        </div>
      )
    }

    <form class="admin-form" method="post">
      <div class="admin-field">
        <label>密码</label>
        <input type="password" name="password" required autofocus autocomplete="current-password" />
      </div>
      <div>
        <button class="admin-btn" type="submit" style="height:40px;padding:0 24px">登录</button>
      </div>
    </form>
  </div>
</AdminLayout>
