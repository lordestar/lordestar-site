---
import AdminLayout from '../../components/admin/AdminLayout.astro';
import { isAuthed } from '../../lib/admin';
import { listAllPosts, listAllWorks, requireDb } from '../../lib/data';

if (!(await isAuthed(Astro.session))) {
  return Astro.redirect('/admin/login');
}

let worksCount = 0;
let postsCount = 0;
let dbError: string | null = null;
try {
  const db = await requireDb();
  [worksCount, postsCount] = await Promise.all([
    listAllWorks(db).then((list) => list.length),
    listAllPosts(db).then((list) => list.length),
  ]);
} catch (err) {
  dbError = (err as Error).message;
}
---

<AdminLayout title="总览">
  <div class="admin-page-head">
    <div>
      <h1>总览</h1>
      <p>内容存于 D1 数据库，编辑后前台即时生效</p>
    </div>
  </div>

  {
    dbError && (
      <div class="admin-error" style="margin-bottom:16px">
        {dbError}
      </div>
    )
  }

  <div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(200px,1fr));gap:16px">
    <a
      class="admin-btn"
      href="/admin/works/"
      style="height:auto;padding:22px;flex-direction:column;align-items:flex-start;gap:8px"
    >
      <span style="font-size:2rem;font-weight:700;font-family:var(--font-display);color:var(--text)"
        >{worksCount}</span
      >
      <span>作品（音乐 + 代码）</span>
    </a>
    <a
      class="admin-btn"
      href="/admin/posts/"
      style="height:auto;padding:22px;flex-direction:column;align-items:flex-start;gap:8px"
    >
      <span style="font-size:2rem;font-weight:700;font-family:var(--font-display);color:var(--text)"
        >{postsCount}</span
      >
      <span>文章（想法）</span>
    </a>
  </div>

  <div
    style="margin-top:28px;display:flex;flex-direction:column;gap:10px;color:var(--muted);font-size:0.9rem"
  >
    <p>· 内容修改后，网站页面（/works、/thoughts 等）下次访问即为最新数据</p>
    <p>· 封面/音频支持上传到本站（R2 存储，免费额度 10GB）</p>
    <p>· 手机 App 记录功能（听歌日记等）在 M3 里程碑开发</p>
  </div>
</AdminLayout>
