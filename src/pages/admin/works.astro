---
import AdminLayout from '../../components/admin/AdminLayout.astro';
import { isAuthed } from '../../lib/admin';
import { deleteWork, listAllWorks, requireDb } from '../../lib/data';
import { slugFromId } from '../../i18n';

if (!(await isAuthed(Astro.session))) {
  return Astro.redirect('/admin/login');
}

let error: string | null = null;
let works: Awaited<ReturnType<typeof listAllWorks>> = [];

try {
  const db = await requireDb();

  // 删除操作
  if (Astro.request.method === 'POST') {
    const form = await Astro.request.formData();
    const action = String(form.get('action') ?? '');
    const id = Number(form.get('id') ?? 0);
    if (action === 'delete' && id > 0) {
      await deleteWork(db, id);
      return Astro.redirect('/admin/works');
    }
  }

  works = await listAllWorks(db);
} catch (err) {
  error = (err as Error).message;
}

const fmtDate = (date: Date) =>
  new Intl.DateTimeFormat('zh-CN', { year: 'numeric', month: 'short' }).format(date);
---

<AdminLayout title="作品管理">
  <div class="admin-page-head">
    <div>
      <h1>作品</h1>
      <p>共 {works.length} 条 · 音乐与代码</p>
    </div>
    <a class="admin-btn" href="/admin/works/new/" style="height:38px;padding:0 18px">＋ 新建作品</a>
  </div>

  {
    error && (
      <div class="admin-error" style="margin-bottom:16px">
        {error}
      </div>
    )
  }

  {
    works.length === 0 ? (
      <p class="admin-empty">还没有作品，点右上角"新建作品"开始。</p>
    ) : (
      <table class="admin-table">
        <thead>
          <tr>
            <th>标题</th>
            <th>语言</th>
            <th>类型</th>
            <th>日期</th>
            <th>精选</th>
            <th style="text-align:right">操作</th>
          </tr>
        </thead>
        <tbody>
          {works.map((work) => (
            <tr>
              <td>
                <a class="title-link" href={`/admin/works/edit/${work.dbId}/`}>
                  {work.data.title}
                </a>
              </td>
              <td>
                <span class:list={['badge', work.id.startsWith('en') && 'badge-en']}>
                  {work.id.startsWith('en') ? 'EN' : 'ZH'}
                </span>
              </td>
              <td>
                <span class="badge">{work.data.type}</span>
              </td>
              <td style="color:var(--muted);font-family:var(--font-mono);font-size:0.8rem">
                {fmtDate(work.data.date)}
              </td>
              <td>{work.data.featured ? <span class="badge badge-featured">★</span> : '—'}</td>
              <td style="text-align:right">
                <a
                  class="admin-btn"
                  href={`/admin/works/edit/${work.dbId}/`}
                  style="margin-right:8px"
                >
                  编辑
                </a>
                <a
                  class="admin-btn"
                  href={`/works/${slugFromId(work.id)}/`}
                  target="_blank"
                  style="margin-right:8px"
                >
                  预览
                </a>
                <form
                  method="post"
                  style="display:inline"
                  onsubmit="return confirm('确定删除这条作品？')"
                >
                  <input type="hidden" name="action" value="delete" />
                  <input type="hidden" name="id" value={work.dbId} />
                  <button class="admin-btn admin-btn-danger" type="submit">
                    删除
                  </button>
                </form>
              </td>
            </tr>
          ))}
        </tbody>
      </table>
    )
  }
</AdminLayout>
