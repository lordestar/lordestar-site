---
import AppLayout from '../../components/app/AppLayout.astro';
import RecordForm from '../../components/app/RecordForm.astro';
import { isAuthed } from '../../lib/admin';
import { ui } from '../../i18n';

if (!(await isAuthed(Astro.session))) {
  return Astro.redirect(`/admin/login?from=${encodeURIComponent('/app/new/')}`);
}
const t = ui.zh;
---

<AppLayout locale="zh" title={t.app.new}>
  <h1 class="app-page-title">{t.app.new}</h1>
  <RecordForm locale="zh" mode="new" />
</AppLayout>

<style>
  .app-page-title {
    font-family: var(--font-display);
    font-size: 1.5rem;
    font-weight: 700;
    letter-spacing: 0;
    margin-bottom: 18px;
  }
</style>
