{
  "name": "lordestar-site",
  "type": "module",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@11.16.0",
  "engines": {
    "node": ">=22.0.0",
    "pnpm": ">=11.0.0"
  },
  "scripts": {
    "predev": "node scripts/photos-manifest.mjs",
    "dev": "node scripts/astro.mjs dev",
    "prebuild": "node scripts/photos-manifest.mjs",
    "build": "node scripts/astro.mjs build",
    "preview": "node scripts/astro.mjs preview",
    "clean": "node scripts/clean.mjs",
    "precheck": "node scripts/photos-manifest.mjs",
    "check": "node scripts/astro.mjs check",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "ci": "pnpm format:check && pnpm check && pnpm build",
    "db:local": "wrangler d1 migrations apply lordestar-db --local && wrangler d1 execute lordestar-db --local --file=scripts/seed-data.sql",
    "db:seed": "node scripts/migrate-content.mjs && wrangler d1 execute lordestar-db --remote --file=scripts/seed-data.sql"
  },
  "dependencies": {
    "@astrojs/cloudflare": "^14.2.3",
    "@astrojs/react": "^6.0.2",
    "@fontsource-variable/archivo": "^5.2.0",
    "@fontsource/ibm-plex-mono": "^5.2.0",
    "@tailwindcss/vite": "^4.3.3",
    "astro": "^7.2.4",
    "marked": "^18.0.10",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "tailwindcss": "^4.3.3"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@cloudflare/workers-types": "^5.20260820.1",
    "@types/node": "^26.1.2",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "bun": "^1.3.14",
    "gray-matter": "^4.0.3",
    "prettier": "^3.9.6",
    "prettier-plugin-astro": "^0.14.1",
    "typescript": "^5.8.0",
    "wrangler": "^4.124.0"
  }
}
